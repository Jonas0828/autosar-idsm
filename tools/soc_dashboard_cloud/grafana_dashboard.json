      "title": "告警事件 (按时间倒序, 自动刷新 10s)",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"idsm_violations\")\n  |> filter(fn: (r) => r._field == \"summary\" or r._field == \"count\" or r._field == \"src_ip\" or r._field == \"dst_ip\")\n  |> pivot(rowKey: [\"_time\", \"severity\", \"detector\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 100)\n  |> map(fn: (r) => ({ Time: r._time, severity: r.severity, detector: r.detector, summary: r.summary, src_ip: r.src_ip, dst_ip: r.dst_ip, count: r.count }))",
          "refId": "A"
        }
      ]
